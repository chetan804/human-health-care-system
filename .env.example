# Development only. Generate actual random local values with scripts/configure_local.py.
# Do not use this file as a production secret store or copy placeholder credentials into deployment.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/hcs
POSTGRES_USER=hcs
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_VALUE
POSTGRES_DB=hcs
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
ENCRYPTION_BACKEND=unconfigured
DOCUMENT_STORAGE_BACKEND=unconfigured
# Explicit synthetic-only alternative: database-development. Forbidden in staging/production.
# No malware scanner is configured; every upload remains quarantined.
# ENCRYPTION_KEY is base64 of exactly 32 random bytes; local-development backend only.
# ENCRYPTION_KEY=
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5173"]
ACCESS_SECONDS=600
REFRESH_DAYS=7
RATE_LIMIT=120
LOGIN_LIMIT=10
REMINDERS_MINUTES=[1440]
# External activation categories, deliberately NOT accepted as active provider configuration:
# EMAIL: provider contract, sender/domain, auth, delivery events
# SMS: provider contract, sender/consent, auth, delivery events
# PAYMENT: merchant, currencies, webhook signatures, reconciliation contract
# INSURANCE: membership/claim schemas, idempotency, retries, reconciliation
# STORAGE: private bucket/endpoint, quarantine, access and scanner contract
# OBSERVABILITY: collector/auth/retention/redaction policy
# ENCRYPTION: production KeyWrapper adapter, key identifiers and secret manager
# Supplying arbitrary provider URLs does NOT activate an integration.
